# Copy to app/.env.language and edit locally; the backend reloads it per health
# check and command, independently of its working directory. Refresh the page.
# No model download or API request occurs just by loading configuration.
# Priority: backend process environment > .env.language > private JSON > defaults.
# Process environment changes require a backend restart. An explicit disabled
# process provider always keeps automated tests offline.
# Format: KEY=VALUE, optional export, single/double quotes, # comment lines or
# whitespace + # trailing comments. No multiline values or variable expansion.
# Duplicate keys: the last assignment wins. Keep only the provider you want.
ROOMWISE_LANGUAGE_PROVIDER=disabled

# Local Ollama, after you install and choose an available model yourself:
# ROOMWISE_LANGUAGE_PROVIDER=ollama
# ROOMWISE_LANGUAGE_URL=http://127.0.0.1:11434/api/chat
# ROOMWISE_LANGUAGE_MODEL=your-installed-model-name

# Optional compatible cloud provider (sends room dimensions, furniture IDs/labels,
# locks/preferences and instructions to that provider; no photos or asset URLs).
# Provider must support JSON-schema or JSON-object chat completions. It may charge.
# Never put a real key in source control, frontend, screenshots or shared files.
# ROOMWISE_LANGUAGE_PROVIDER=chatcompletions
# ROOMWISE_LANGUAGE_URL=https://your-provider.example/v1/chat/completions
# ROOMWISE_LANGUAGE_MODEL=your-model-name
# ROOMWISE_LANGUAGE_API_KEY=set-in-private-process-environment

# DeepSeek JSON mode (model availability depends on your account):
# ROOMWISE_LANGUAGE_PROVIDER=chatcompletions
# ROOMWISE_LANGUAGE_URL=https://api.deepseek.com
# ROOMWISE_LANGUAGE_MODEL=deepseek-flash
# ROOMWISE_LANGUAGE_RESPONSE_FORMAT=json_object
# ROOMWISE_LANGUAGE_API_KEY=set-in-private-process-environment

# Optional alternative .env file (set in the backend process environment):
# ROOMWISE_LANGUAGE_ENV_FILE=/absolute/path/to/private.env

# Optional private JSON config (reloaded per command; environment/.env overrides):
# ROOMWISE_LANGUAGE_CONFIG=/absolute/path/to/language.local.json
# Default path: app/runtime/language.local.json; absent configuration means disabled.
# Keys: provider, url, model, apiKey, responseFormat.
